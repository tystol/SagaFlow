<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SagaFlow.AspNetCore\SagaFlow.AspNetCore.csproj" />
    <ProjectReference Include="..\..\SagaFlow.SignalR\SagaFlow.SignalR.csproj" />
    <ProjectReference Include="..\SimpleMvcExample.Messages\SimpleMvcExample.Messages.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.20" />
    <PackageReference Include="Rebus.PostgreSql" Version="8.1.0" />
    <PackageReference Include="Rebus.SqlServer" Version="7.3.1" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="FrontEndPlugins\" />
  </ItemGroup>
  <Target Name="BuildFrontendAndEmbed" BeforeTargets="PrepareForBuild">
    <Exec WorkingDirectory="..\SimpleMvcExample.FrontEndPlugins\hello-plugin" Command="npm ci" />
    <Exec WorkingDirectory="..\SimpleMvcExample.FrontEndPlugins\hello-plugin" Command="npm run build" />
    <ItemGroup>
      <HelloPluginFiles Include="..\SimpleMvcExample.FrontEndPlugins\hello-plugin\dist\**" />
    </ItemGroup>
    <Copy SourceFiles="@(HelloPluginFiles)" DestinationFolder="FrontEndPlugins\hello-plugin\%(RecursiveDir)" />
    <!--<Copy SourceFiles="..\SimpleMvcExample.FrontEndPlugins\hello-plugin\dist\hello-plugin.js" DestinationFolder="FrontEndPlugins\hello-plugin" />-->
    <!--<Copy SourceFiles="..\SimpleMvcExample.FrontEndPlugins\hello-plugin\dist\**\*.*" DestinationFolder="FrontEndPlugins\hello-plugin" />-->
    <ItemGroup>
      <None Remove="FrontEndPlugins\**" />
      <EmbeddedResource Include="FrontEndPlugins\**" />
    </ItemGroup>
  </Target>
 <!-- <ItemGroup>
    <None Remove="FrontEndPlugins\**" />
    <EmbeddedResource Include="FrontEndPlugins\**" />
  </ItemGroup>-->
  <!-- Dynamically add embedded resources *after* files exist from the above build/copy steps -->
  <!--<Target Name="EmbedFrontend" AfterTargets="BuildFrontend" BeforeTargets="PrepareResources">
    <ItemGroup>
      <None Remove="FrontEndPlugins\**" />
      <EmbeddedResource Include="FrontEndPlugins\**" />
    </ItemGroup>
  </Target>  -->
</Project>
